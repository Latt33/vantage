# =============================================================================
# HACKATHON MONOREPO - Environment Variables
# =============================================================================
# Copy this file to .env.local for local development
# IMPORTANT: Never commit actual values to version control!

# =============================================================================
# SUPABASE (Database + Auth)
# =============================================================================
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL={{cookiecutter.supabase_project_ref}}.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# =============================================================================
# VERCEL (Frontend + Serverless Functions)
# =============================================================================
# Get these from: https://vercel.com/dashboard → Settings → Environment Variables
VERCEL_TOKEN=your-vercel-token-here
VERCEL_ORG_ID={{cookiecutter.vercel_team_slug}}
VERCEL_PROJECT_ID=your-project-id-here

{% if cookiecutter.inference_backend == "cloudrun" %}
# =============================================================================
# GOOGLE CLOUD (Cloud Run for Inference Service)
# =============================================================================
# Create a service account with Cloud Run Admin + Artifact Registry roles
# Download JSON key and encode: base64 -i key.json | tr -d '\n'
GCP_SA_KEY='{"type":"service_account","project_id":"{{cookiecutter.gcp_project_id}}"}'
GCP_PROJECT_ID={{cookiecutter.gcp_project_id}}
{% else %}
# =============================================================================
# VERDA GPU (Bare Metal GPU Rental — SSH Access)
# =============================================================================
# Verda lends you a bare GPU machine with SSH access.
# You provide a startup script that installs your inference stack.
# There is no Verda API — connect via SSH to your rented machine.
# Get SSH credentials from https://verda.ai/dashboard
VERDA_SSH_HOST={{cookiecutter.verda_ssh_host}}
VERDA_SSH_PORT={{cookiecutter.verda_ssh_port}}
VERDA_SSH_USER={{cookiecutter.verda_ssh_user}}
# Path to your private SSH key
VERDA_SSH_KEY_PATH=~/.ssh/verda_ed25519
# Startup script path (provision.sh runs on the Verda machine at boot)
VERDA_STARTUP_SCRIPT=services/inference/provision.sh
{% endif %}

{% if cookiecutter.auth_provider == "nextauth" %}
# =============================================================================
# NEXTAUTH.JS (Google OAuth — add-on to Supabase Auth)
# =============================================================================
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
# Create an OAuth 2.0 Client ID (Web application)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-random-secret
NEXTAUTH_URL=http://localhost:3000
{% endif %}

{% if cookiecutter.payments == "stripe" %}
# =============================================================================
# STRIPE (Payments)
# =============================================================================
# Get from: https://dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
{% endif %}

{% if cookiecutter.queue_backend == "upstash" %}
# =============================================================================
# UPSTASH REDIS (Queue + Caching — free tier)
# =============================================================================
# Get from: https://console.upstash.com → Redis → Your database → Details
# UPSTASH_REDIS_REST_URL is the HTTP endpoint (starts with https://)
UPSTASH_REDIS_REST_URL={{cookiecutter.upstash_redis_rest_url}}
# UPSTASH_REDIS_REST_TOKEN is the token from the same page
UPSTASH_REDIS_REST_TOKEN={{cookiecutter.upstash_redis_rest_token}}
{% endif %}

{% if cookiecutter.inference_pattern in ["async_http", "sync_http"] %}
# =============================================================================
# INFERENCE API (direct HTTP — no queue worker)
# =============================================================================
# The URL of your inference service (Cloud Run or Verda HTTP endpoint)
# Used when inference_pattern is async_http or sync_http (API calls inference directly)
INFERENCE_API_URL=https://your-inference-service.run.app
{% endif %}

# =============================================================================
# BRANCH MAPPING (for deploy workflow)
# =============================================================================
# main      → production
# staging   → staging
# dev       → preview/development
# feature/* → ephemeral previews